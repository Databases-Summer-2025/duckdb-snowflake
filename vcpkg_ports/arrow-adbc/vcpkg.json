{
  "name": "arrow-adbc",
  "version": "18.0.0",
  "port-version": 1,
  "description": "Apache Arrow ADBC (Arrow Database Connectivity) provides a database-independent API for working with databases using Arrow data",
  "homepage": "https://github.com/apache/arrow-adbc",
  "license": "Apache-2.0",
  "dependencies": [
    "arrow",
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "postgresql": {
      "description": "Build the PostgreSQL driver",
      "dependencies": [
        "libpq"
      ]
    },
    "sqlite": {
      "description": "Build the SQLite driver"
    },
    "flightsql": {
      "description": "Build the FlightSQL driver"
    },
    "snowflake": {
      "description": "Build the Snowflake driver",
      "dependencies": [
        "openssl"
      ]
    }
  },
  "default-features": []
}